{
  "manifest_version": 3,
  "name": "WARC Archiver",
  "version": "0.1.0",
  "description": "A Chrome extension to capture and save web pages as WARC files.",
  "permissions": ["activeTab", "scripting", "webRequest", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["<all_urls>"]
}
